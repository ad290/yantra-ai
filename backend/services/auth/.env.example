AUTH_PORT=8011

MONGODB_URL=mongodb://127.0.0.1:27017/real-time-ai-code-editor

REDIS_URL=redis://127.0.0.1:6379

NODE_ENV=development

# Must match gateway ACCESS_TOKEN_SECRET
ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars
REFRESH_TOKEN_PEPPER=change-me-refresh-pepper-min-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Cookie path as seen by the browser (via API gateway)
REFRESH_COOKIE_PATH=/api/auth

# Shared with payment and AI services for credit mutations
INTERNAL_SERVICE_KEY=change-me-internal-service-key
