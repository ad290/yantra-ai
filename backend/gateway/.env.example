PORT=8000

# Must match the Vite dev server origin (cookies + CORS)
FRONTEND_URL=http://localhost:5173

AUTH_SERVICE_URL=http://localhost:8011
PROJECT_SERVICE_URL=http://localhost:8002
FILE_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
PAYMENT_SERVICE_URL=http://localhost:8005

REDIS_URL=redis://127.0.0.1:6379

# Must match auth service ACCESS_TOKEN_SECRET
ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars

# For /api/me profile fetch from auth service
INTERNAL_SERVICE_KEY=change-me-internal-service-key
